{
  "name": "pos-backend",
  "version": "1.0.0",
  "description": "POS System Backend with NestJS, PostgreSQL, and TypeORM",
  "author": "Your Name",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:export": "ts-node scripts/export-db.ts",
    "db:import": "ts-node scripts/import-db.ts",
    "db:seed-users": "ts-node scripts/seed-users.ts",
    "db:seed-demo": "ts-node scripts/seed-demo.ts",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:general": "node scripts/verify-general-flow.mjs",
    "verify:restaurant": "node scripts/verify-restaurant-flow.mjs",
    "verify:realtime": "node scripts/verify-realtime.mjs",
    "verify:all": "npm run verify:auth && npm run verify:general && npm run verify:restaurant && npm run verify:shifts && npm run verify:realtime && npm run verify:order-numbers && npm run verify:pagination && npm run verify:search",
    "verify:shifts": "node scripts/verify-shifts.mjs",
    "db:seed-restaurant": "ts-node scripts/seed-restaurant.ts",
    "verify:order-numbers": "node scripts/verify-order-numbers.mjs",
    "verify:pagination": "node scripts/verify-pagination.mjs",
    "db:seed-snackfuel": "ts-node scripts/seed-snackfuel.ts",
    "verify:search": "node scripts/verify-search.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.1.16",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.4.22",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cron": "3.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.19"
  },
  "overrides": {
    "cron": "3.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^3.0.13",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
