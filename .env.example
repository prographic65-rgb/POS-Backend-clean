# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pos

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Access-token lifetime. MUST carry a unit ('30m', '2h', '1d').
# A bare number here is read by jsonwebtoken as MILLISECONDS, so the old
# `JWT_EXPIRATION=86400` produced an 86-second token rather than 24 hours and
# logged users out mid-session. The app now refuses to boot on a unitless value.
JWT_ACCESS_EXPIRATION=30m

# Refresh-token lifetime in days. Rotation does not extend it: after this the
# user signs in again.
REFRESH_TOKEN_TTL_DAYS=7

# CORS Configuration
CORS_ORIGIN=http://localhost:8080

# Where uploaded tenant assets (store logos) are written, and served from at
# /api/uploads/. Defaults to POS-Backend/uploads — deliberately OUTSIDE dist,
# which `npm run prebuild` deletes on every build. Point this at a persistent
# volume in production, or logos vanish on the next deploy.
UPLOAD_DIR=

# Daily order-number reset. OrderSequenceResetService zeroes every restaurant's
# `stores.orderSequence` at this hour, so the first bill afterwards reads #1
# again. Only the DISPLAY number resets; `orders.orderNumber` is globally
# unique and untouched.
#
# The timezone is not optional in production: the server runs UTC, so a bare
# hour of 6 would fire at 11am in Karachi. Must be an IANA zone name.
ORDER_SEQUENCE_RESET_HOUR=6
ORDER_SEQUENCE_RESET_TIMEZONE=Asia/Karachi
